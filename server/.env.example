# Server & Database Configuration
PORT=9000
MONGODB_URI=mongodb://localhost:27017/sureservice
CLIENT_URL=http://localhost:5173

# Feature Flags
ENABLE_DEMO_LOGIN=true

# JWT Authentication & Security
ACCESS_TOKEN_SECRET=your_super_secret_access_token_jwt_key
REFRESH_TOKEN_SECRET=your_super_secret_refresh_token_jwt_key
ACCESS_TOKEN_EXPIRESIN=900
REFRESH_TOKEN_EXPIRESIN=604800
SALT_ROUNDS=10

# Demo Credentials & Role-based Quick Login (Optional Overrides)
DEMO_USER_PASSWORD=DemoPassword123!
DEMO_CUSTOMER_EMAIL=customer@sureservice.com
DEMO_PROVIDER_EMAIL=provider@sureservice.com
DEMO_ADMIN_EMAIL=admin@sureservice.com

# Cloudinary CDN Configuration
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

